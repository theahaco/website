---
// Floating "Schedule a call" Calendly badge (home page only, hidden below 768px).
import { calendly } from '../data/site';
const init = `Calendly.initBadgeWidget(${JSON.stringify({
  url: calendly.url,
  text: calendly.badgeText,
  color: calendly.badgeColor,
  textColor: calendly.badgeTextColor,
  branding: false,
})});`;
---
<link href="https://assets.calendly.com/assets/external/widget.css" rel="stylesheet" />
<script is:inline async src="https://assets.calendly.com/assets/external/widget.js" onload={init}></script>
