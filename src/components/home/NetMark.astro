---
// A network's symbol, cropped from the left of its logo in
// public/images/logos (each of these wordmarks starts with the symbol;
// `ratio` is the symbol's width over its height, measured on the file).
// Decorative: the network's name is always written next to it.
import { networkSymbols, type NetworkId } from '../../lib/networkMarks';
interface Props {
  net: NetworkId;
  size?: number;
  lazy?: boolean;
  class?: string;
  'data-cs'?: string;
}
const { net, size = 16, lazy = false, class: cls, 'data-cs': dataCs } = Astro.props;
const m = networkSymbols[net];
const width = Math.ceil(size * m.ratio);
---
<img alt="" class:list={['netmark', cls]} data-cs={dataCs} src={m.src} width={width} height={size} style={`width:${width}px;height:${size}px`} loading={lazy ? 'lazy' : undefined} decoding="async" />

<style>
  .netmark { display: block; flex-shrink: 0; max-width: none; object-fit: cover; object-position: left center; }
</style>
