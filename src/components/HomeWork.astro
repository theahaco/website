---
// Home page "Selected work": case studies tab (with quotes and the NDA block)
// and articles tab. Webflow tabs markup, driven by src/scripts/tabs.js.
import { caseStudies, posts, tools, pick, publicQuote } from '../lib/content';
import { homeFeaturedCases, homeNdaCases, homeArticles } from '../data/curation';

const all = await caseStudies();
const featured = pick(all, homeFeaturedCases);
const nda = pick(all, homeNdaCases);
// The three most recent articles, unless curation.ts pins a selection.
const allPosts = await posts();
const articles = homeArticles.length ? pick(allPosts, homeArticles) : allPosts.slice(0, 3);
const toolList = await tools();
import { site as siteData } from '../data/site';
const production = !Astro.site || Astro.site.origin === siteData.productionOrigin;
---
<div class="work_tabs w-tabs" data-current="Tab 1" data-duration-in="300" data-duration-out="100" data-easing="ease">
  <div aria-label="Work type" class="work_toggle w-tab-menu">
    <a class="work_toggle-btn w-inline-block w-tab-link w--current" data-w-tab="Tab 1" href="#work-cases">Case studies</a>
    {articles.length > 0 && <a class="work_toggle-btn w-inline-block w-tab-link" data-w-tab="Tab 2" href="#work-articles">Articles</a>}
  </div>
  <div class="work_panels w-tab-content">
    <div class="w-tab-pane w--tab-active" data-w-tab="Tab 1" id="work-cases">
      <div class="w-dyn-list">
        <div class="work_list w-dyn-items" role="list">
          {featured.map((cs) => {
            const Row = cs.data.alliance ? 'div' : 'a';
            return (
            <div class="work_item w-dyn-item" role="listitem" data-client={cs.id}>
              <div class="work_row">
                <Row class:list={['work_case-link w-inline-block', cs.data.alliance && 'wk_static']} href={cs.data.alliance ? undefined : `/case-studies/${cs.id}`}>
                  <div class="work_num"></div>
                  <div class="work_stack">
                    <div class="work_meta">
                      {cs.data.eyebrow && <p class="work_eyebrow">{cs.data.eyebrow}</p>}
                      <div class="work_yeararrow">
                        {cs.data.year && <div>{cs.data.year}</div>}
                        {!cs.data.alliance && <div aria-hidden="true" class="work_arrow">↗</div>}
                      </div>
                    </div>
                    <h3 class="work_h3">{cs.data.title}</h3>
                    {cs.data.lede && <p class="work_para">{cs.data.lede}</p>}
                  </div>
                </Row>
                {(() => { const q = publicQuote(cs.data.quote, production); return (
                <figure class:list={['work_quote', !q.text && 'work_quote--plain']}>
                  <p class="work_quote-label">{q.label}</p>
                  {q.text && <blockquote class="work_blockquote">{q.text}</blockquote>}
                  {(q.author || q.portrait) && <figcaption class="work_attrib">
                    {q.portrait && <img alt={q.portraitAlt} class="work_portrait" loading="lazy" src={q.portrait} width="32" height="32" />}
                    <div class="work_attrib-info">
                      {q.author && <p class="work_attrib-name">{q.author}</p>}
                      {q.role && <p class="work_attrib-role">{q.role}</p>}
                    </div>
                  </figcaption>}
                  {q.logo && <img alt={q.logoAlt} class="work_client-logo" loading="lazy" src={q.logo} />}
                </figure>
                ); })()}
              </div>
            </div>
          ); })}
        </div>
      </div>
      {nda.length > 0 && (
        <div aria-label="Engagements under NDA" class="work_nda">
          <p class="work_nda-label">Client under NDA</p>
          <div class="w-dyn-list">
            <div class="work_nda-list w-dyn-items" role="list">
              {nda.map((cs) => (
                <div class="work_nda-item w-dyn-item" role="listitem">
                  <a class="w-inline-block" data-nda-link="1" href={`/case-studies/${cs.id}`}>
                    <div>
                      {cs.data.eyebrow && <p class="work_nda-eyebrow">{cs.data.eyebrow}</p>}
                      {cs.data.ndaSummary && <p class="work_nda-body">{cs.data.ndaSummary}</p>}
                    </div>
                  </a>
                </div>
              ))}
            </div>
          </div>
        </div>
      )}
      {toolList.length > 0 && (
        <div aria-label="Open-source tools" class="work_nda" data-rv="home-tools">
          <div class="work_os-head">
            <p class="work_nda-label">Open source</p>
            <a class="work_os-all" href="/open-source">All tools ↗</a>
          </div>
          <div class="work_nda-list" role="list">
            {toolList.map((tool) => (
              <div class="work_nda-item" role="listitem">
                <a class="w-inline-block" data-nda-link="1" href={`/open-source/${tool.id}`}>
                  <div>
                    <p class="work_nda-eyebrow">{tool.data.category} · {tool.data.network}</p>
                    <p class="work_nda-body"><span class="work_os-name">{tool.data.name}</span> {tool.data.summary}</p>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
    <div class="w-tab-pane" data-w-tab="Tab 2" id="work-articles">
      <div class="w-dyn-list">
        <div class="work_list w-dyn-items" role="list">
          {articles.map((post) => (
            <div class="work_item w-dyn-item" role="listitem">
              <a class="work_article-link w-inline-block" href={`/blog/${post.id}`}>
                <div class="work_num"></div>
                <div class="work_stack">
                  <div class="work_meta">
                    {post.data.category && <p class="work_eyebrow">{post.data.category}</p>}
                    <div aria-hidden="true" class="work_arrow">↗</div>
                  </div>
                  <h3 class="work_article-h3">{post.data.title}</h3>
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
  <a class="btn-secondary work_all" href="/work">See all work →</a>
</div>
