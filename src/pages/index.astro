<BaseLayout title={'The Aha Company: blockchain integration partner for institutions, protocols and ecosystems'} description={'We integrate financial institutions and protocols onto Stellar, XRPL and Canton, and build the developer tooling those ecosystems run on.'}>
<main><section class="hero_section"><div class="hero_text"><p class="eyebrow">Blockchain integration partner</p><h1 class="heading-1">We integrate institutions and protocols onto the networks we help build.</h1><p class="hero_lead">Stablecoins, tokenized funds and deposits for banks. Integrations for protocols expanding to a new network. Developer tooling for the ecosystems themselves.</p><div class="hero_actions"><a class="btn-primary" href="/contact">Schedule a call</a><a class="btn-secondary" href="/work">See our work</a></div><ul aria-label="Key figures" class="hero_stats" role="list"><li class="hero_stat"><div class="hero_stat-value"><div>€20M+</div><a aria-label="Receipt: EURCV on the Stellar explorer" class="receipt-badge" href="https://stellar.expert/explorer/public/asset/EURCV-GCEYGIVOLAVBF2TG2RUSGTUJCIN75KEX3NGLMY4VPL4GFE5L355AXW3G" title="Receipt">✓</a></div><div class="hero_stat-caption">Regulated stablecoins issued onchain</div></li><li class="hero_stat" data-rv="stat-deploy"><div class="hero_stat-value"><div>20+</div></div><div class="hero_stat-caption">Deployments on mainnet</div></li><li class="hero_stat" data-rv="stat-team"><div class="hero_stat-value"><div>12+</div></div><div class="hero_stat-caption">Engineers across the United States, Europe and Brazil</div></li></ul></div><figure aria-label="Live on mainnet" class="hero_card"><div class="hero_card-header"><p class="hero_card-title">Live on mainnet</p></div><ul class="hero_card-rows" role="list"><li class="hero_card-row"><div class="hero_card-client">Société Générale FORGE</div><div class="hero_card-status"><div class="status-dot"></div><div data-rv="card-eurcv">Live since Q1 2026</div></div><div class="hero_card-line2"><p class="hero_card-desc">EURCV regulated euro stablecoin · Stellar</p><div class="hero_card-figure"><div>€20M+ issued</div><a aria-label="Receipt: EURCV on the Stellar explorer" class="receipt-badge" href="https://stellar.expert/explorer/public/asset/EURCV-GCEYGIVOLAVBF2TG2RUSGTUJCIN75KEX3NGLMY4VPL4GFE5L355AXW3G" title="Receipt">✓</a></div></div></li><li class="hero_card-row"><div class="hero_card-client">Top US commercial bank</div><div class="hero_card-status"><div class="status-dot"></div><div data-rv="card-bank">Live pilot</div></div><div class="hero_card-line2"><p class="hero_card-desc">Settlement stablecoin · Stellar</p></div></li><li class="hero_card-row"><div class="hero_card-client">LI.FI</div><div class="hero_card-status"><div class="status-dot"></div><div>Live</div></div><div class="hero_card-line2"><p class="hero_card-desc">Cross-chain asset transfers · Stellar</p></div></li></ul><figcaption class="hero_card-footer" data-rv="card-footer"><div>4 networks</div><div>12+ engineers</div></figcaption></figure></section><section aria-label="Clients and partners" class="logos_section"><div class="logos_container"><div class="logos_mask"><ul aria-label="Clients and partners" class="logos_track" role="list"><li class="logos_logo"><img alt="Stellar Development Foundation" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-stellar.webp"/></li><li class="logos_logo"><img alt="Société Générale FORGE" class="logos_img-36" loading="lazy" src="/images/logos/logo-dark-sgforge.webp"/></li><li class="logos_logo"><img alt="Ripple" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-ripple.webp"/></li><li class="logos_logo"><img alt="Filecoin" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-filecoin.webp"/></li><li class="logos_logo"><img alt="LI.FI" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-lifi.webp"/></li><li class="logos_logo"><img alt="Banque Delubac et Cie" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-delubac.svg"/></li><li class="logos_logo"><img alt="Canton" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-canton-lime.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-stellar.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-36" loading="lazy" src="/images/logos/logo-dark-sgforge.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-ripple.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-filecoin.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-lifi.webp"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-26" loading="lazy" src="/images/logos/logo-dark-delubac.svg"/></li><li aria-hidden="true" class="logos_logo"><img alt="" class="logos_img-24" loading="lazy" src="/images/logos/logo-dark-canton-lime.webp"/></li></ul></div><div class="logos_networks"><p class="logos_networks-label">Networks we build on</p><ul class="logos_networks-list" role="list"><li><img alt="Stellar" class="logos_mark-20" loading="lazy" src="/images/logos/logo-dark-stellar.webp"/></li><li><img alt="XRP Ledger" class="logos_mark-20" loading="lazy" src="/images/logos/logo-dark-xrpl.webp"/></li><li><img alt="Canton" class="logos_mark-18" loading="lazy" src="/images/logos/logo-dark-canton.webp"/></li><li><img alt="Ethereum" class="logos_mark-20" loading="lazy" src="/images/logos/logo-dark-ethereum.webp"/></li></ul></div></div></section><section id="work"><div class="section-inner work_layout"><h2 class="work_h2">Selected work</h2><HomeWork /></div></section><section class="services_section" id="what-we-do"><div class="section-inner"><h2 class="section_h2">What we do</h2><ul class="services_grid" role="list"><li><article class="services_card"><h3 class="services_card-h3">Stablecoin issuance and governance</h3><p class="services_card-desc">Issuance contracts a regulated issuer can operate.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Role separation, freeze and clawback</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Allow and deny lists, alerting-to-freeze automation</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Mint and burn bridges to core banking</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text"> EURCV; a US bank's settlement stablecoin</div></div></article></li><li><article class="services_card"><h3 class="services_card-h3">Tokenized funds and deposits</h3><p class="services_card-desc">Fund units and deposits mapped to the legal structure.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Transfer restrictions in the contract</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Subscriptions and redemptions onchain</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Custody integration</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text" data-rv="precedent-fund"> A tokenized share class of a money-market fund for a regulated European private bank, in build</div></div></article></li><li><article class="services_card"><h3 class="services_card-h3">Protocol and product integration</h3><p class="services_card-desc">Your protocol or product on Stellar, XRPL or Canton, whether it is live elsewhere or launching for the first time.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Integration roadmap</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Native contracts, adapters and SDKs</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Routing and liquidity</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text"> LI.FI on Stellar</div></div></article></li><li><article class="services_card"><h3 class="services_card-h3">Custody, wallets and accounts</h3><p class="services_card-desc">From custodian integrations to smart accounts and passkeys.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Custodian and MPC integrations</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>KYT through the custodian</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Smart accounts and passkeys</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text"> Nido, our open-source passkey wallet</div></div></article></li><li><article class="services_card"><h3 class="services_card-h3">Developer tooling and DevX</h3><p class="services_card-desc">A two-week DevX audit by two senior engineers, then a tooling roadmap.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>CLIs and scaffolding</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Registries and sandboxes</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Maintained as public goods</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text"> Stellar CLI plugins and bindings, Scaffold Stellar, Stellar Registry</div></div></article></li><li><article class="services_card"><h3 class="services_card-h3">Architecture and embedded engineering</h3><p class="services_card-desc">We design the system and lead delivery with your engineers, or place a principal engineer with your team.</p><ul class="services_bullets" role="list"><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Architecture and delivery lead</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>With your engineers or your consultancy's</div></li><li class="services_bullet"><div aria-hidden="true" class="services_bullet-arrow">→</div><div>Principal engineer placed for a quarter or more</div></li></ul><div class="services_precedent"><div class="services_precedent-label">Precedent</div><div class="inline-text" data-rv="precedent-arch"> A US bank’s settlement stablecoin; SDF Architect Program</div></div></article></li></ul></div></section><section class="process_section"><div class="section-inner process_layout"><div class="networks_header"><h2 class="process_h2">How an engagement runs</h2></div><div class="work_tabs w-tabs" data-current="Tab 1" data-duration-in="300" data-duration-out="100" data-easing="ease"><div aria-label="Engagement type" class="process_tabs w-tab-menu"><a class="process_tab w-inline-block w-tab-link w--current" data-w-tab="Tab 1">Financial institutions</a><a class="process_tab w-inline-block w-tab-link" data-w-tab="Tab 2">Protocols and products</a><a class="process_tab w-inline-block w-tab-link" data-w-tab="Tab 3">Ecosystems and foundations</a></div><div class="work_panels w-tab-content"><div class="w-tab-pane w--tab-active" data-w-tab="Tab 1"><ul aria-label="Financial institutions" class="process_steps" role="list"><li class="process_step"><div class="process_step-num">1</div><h3 class="process_step-h3">Scoping</h3><p class="process_step-body">One technical session with your lead: who holds admin, mint and burn authority; custody and key management; freeze, clawback, allow and deny lists; KYT; the bridge to your core banking.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> the end-to-end process, who does what.</div></div></li><li class="process_step"><div class="process_step-num">2</div><h3 class="process_step-h3">Structure</h3><p class="process_step-body">NDA, then an MOU with the scope cut into milestones your team can verify. Where an ecosystem program applies, we scope and draft the application; where it doesn't, we say so.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> signed MOU, milestone plan, funding application where one applies.</div></div></li><li class="process_step"><div class="process_step-num">3</div><h3 class="process_step-h3">Build</h3><p class="process_step-body">A first release scoped to two or three use cases and designed to scale, on testnet with your operations team, each milestone validated with you and, where relevant, the network's foundation.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> contracts and integration live on testnet, validated milestone by milestone.</div></div></li><li class="process_step"><div class="process_step-num">4</div><h3 class="process_step-h3">Mainnet and after</h3><p class="process_step-body">Deployment, runbooks and handover, then the changes production surfaces. We stay on the account.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> mainnet deployment, runbooks, handover, ongoing support.</div></div></li></ul></div><div class="w-tab-pane" data-w-tab="Tab 2"><ul aria-label="Protocols and products" class="process_steps" role="list"><li class="process_step"><div class="process_step-num">1</div><h3 class="process_step-h3">Roadmap</h3><p class="process_step-body">We map your integration surface to the target network and size the work.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> integration map and sizing.</div></div></li><li class="process_step"><div class="process_step-num">2</div><h3 class="process_step-h3">Proposal</h3><p class="process_step-body">Milestone-based scope, with or without an ecosystem program behind it.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> milestone proposal, program application where one applies.</div></div></li><li class="process_step"><div class="process_step-num">3</div><h3 class="process_step-h3">Build</h3><p class="process_step-body">Native contracts, adapters and SDKs, tested against your existing suite.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> contracts, adapters and SDKs passing your test suite.</div></div></li><li class="process_step"><div class="process_step-num">4</div><h3 class="process_step-h3">Mainnet</h3><p class="process_step-body">Launch, docs, and a maintenance plan your engineers can run.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> mainnet launch, docs, maintenance plan.</div></div></li></ul></div><div class="w-tab-pane" data-w-tab="Tab 3"><ul aria-label="Ecosystems and foundations" class="process_steps" role="list"><li class="process_step"><div class="process_step-num">1</div><h3 class="process_step-h3">DevX audit</h3><p class="process_step-body">Two engineers, two weeks, on your real onboarding path.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> audit report of the onboarding path, ranked friction points.</div></div></li><li class="process_step"><div class="process_step-num">2</div><h3 class="process_step-h3">Roadmap</h3><p class="process_step-body">Tooling priorities with the ecosystem's engineering team.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> prioritised tooling roadmap.</div></div></li><li class="process_step" data-rv="eco-build"><div class="process_step-num">3</div><h3 class="process_step-h3">Build</h3><p class="process_step-body">CLIs, scaffolding, sandboxes, registries, wallets.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> shipped tooling, open source, with docs.</div></div></li><li class="process_step" data-rv="eco-maintain"><div class="process_step-num">4</div><h3 class="process_step-h3">Maintain</h3><p class="process_step-body">Quarterly public-goods proposal and review.</p><div class="process_step-output"><div class="process_step-output-label">Output:</div><div class="inline-text"> maintained releases and a quarterly proposal.</div></div></li></ul></div></div></div></div></section><section class="ways_section" id="ways"><div class="section-inner"><h2 class="section_h2">Ways to work with us</h2><ul class="ways_grid" role="list"><li class="ways_item"><h3 class="ways_h3">Integration partner</h3><p class="ways_body">Fixed scope, milestone-based, our team end to end. As with EURCV and LI.FI.</p><div class="ways_meta"><div class="ways_meta-label">First two weeks</div><div class="inline-text"> scoping session</div></div></li><li class="ways_item"><h3 class="ways_h3">Architecture lead with your engineers</h3><p class="ways_body">We design the system and lead delivery inside your team or your consultancy's. <span data-rv="ways-pwc">Co-selling alliance with PwC US to tackle clients together.</span></p><div class="ways_meta"><div class="ways_meta-label">First two weeks</div><div class="inline-text"> architecture note</div></div></li><li class="ways_item"><h3 class="ways_h3">Embedded principal engineer</h3><p class="ways_body">A senior engineer placed with your team for a quarter or more. As with the Stellar Development Foundation.</p><div class="ways_meta"><div class="ways_meta-label">First two weeks</div><div class="inline-text"> onboarding</div></div></li><li class="ways_item"><h3 class="ways_h3">Programs for ecosystems</h3><p class="ways_body">DevX audits, tooling roadmaps, accelerator and hackathon mentoring. As with Ripple.</p><div class="ways_meta"><div class="ways_meta-label">First two weeks</div><div class="inline-text"> audit kickoff</div></div></li></ul><figure class="ways_team"><img alt="The Aha Company engineering team" class="ways_team-img" height="Auto" loading="lazy" src="/images/photos/team-photo-office.webp" width="Auto"/><figcaption class="ways_team-caption"><div>The team</div><div data-rv="ways-team-caption">United States · Europe · Brazil</div></figcaption></figure></div></section><section class="networks_section" id="networks"><div class="section-inner"><div class="networks_header"><h2 class="section_h2">Networks</h2><a class="networks_github" href="/networks">Which network fits your case? →</a></div><HomeNetworks /></div></section></main>
<Cta heading={'Bring your institution or protocol onchain, with the team that builds the tooling.'} />
<CalendlyBadge slot="after-footer" />
<Fragment slot="head"><script type="application/ld+json" set:html={orgLd} /><script type="application/ld+json" set:html={webLd} /></Fragment>
</BaseLayout>
