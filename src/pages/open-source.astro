---
// Open-source tools and standards (src/data/opensource.ts). Suggested page:
// listed in the review mode until accepted.
import BaseLayout from '../layouts/BaseLayout.astro';
import Cta from '../components/Cta.astro';
import { tools, standards } from '../data/opensource';
import { team } from '../lib/content';

const people = new Map((await team()).map((m) => [m.id, m]));
const metrics = [
  { figure: '137', label: 'Projects using at least one of our tools (2 Nov 2026)', receipt: '' },
  { figure: '~20%', label: 'Of Stellar CLI commits, 2022 to 2025', receipt: 'https://github.com/stellar/stellar-cli' },
  { figure: '125,107', label: 'Downloads of our Stellar crates since 2023 (2 Nov 2026)', receipt: '' },
  { figure: '~$1.4M', label: 'Public-goods funding the Stellar Community Fund voted on Tansu, Q2 to Q4 2026', receipt: 'https://app.tansu.dev' },
];
---
<BaseLayout title="Open source: the tools we build and maintain | The Aha Company" description="The open-source tooling behind our work: core contributions to the Stellar CLI, Scaffold Stellar, the Stellar Registry, Nido, Moonlight, Tansu and GhostSig, with their status, audits and adoption.">
  <main data-main="1" data-os="page">
    <section>
      <div class="svc_introcontainer">
        <a class="art_back" data-back="1" href="/">← Back to home</a>
        <div class="lg_header">
          <p class="cs_eyebrow">Open source</p>
          <h1 class="intro_h1">Public code you can inspect, commit by commit.</h1>
          <p class="art_lede" data-os="lede">The tooling behind our work is open source. On Stellar we are core contributors to the official CLI and build the tools around it; some of them already serve XRPL. Each one below says what it does, what we built and where it stands.</p>
        </div>
      </div>
    </section>
    <section aria-label="In numbers" class="cs_outcomes" data-os="metrics">
      <ul class="cs_metrics" role="list">
        {metrics.map((m) => (
          <li class="cs_metric">
            <span class="cs_fig"><span>{m.figure}</span>{m.receipt && <a aria-label="Receipt" class="cs_figmark" href={m.receipt}>✓</a>}</span>
            <span class="cs_metriclabel">{m.label}</span>
          </li>
        ))}
      </ul>
    </section>
    <section class="ab_white">
      <div class="ab_container">
        <h2 class="ab_h2">The tools</h2>
        <ul class="os_grid" data-os="tools" role="list">
          {tools.map((t) => (
            <li class="os_card" id={t.slug} data-os-tool={t.slug}>
              <div class="os_head">
                <h3 class="os_name">{t.name}</h3>
                <span class="os_net">{t.network}</span>
              </div>
              <p class="os_what">{t.what}</p>
              <p class="os_why">{t.why}</p>
              <dl class="os_facts">
                <div class="cs_fact"><dt class="cs_dt">Our role</dt><dd class="os_dd">{t.role}</dd></div>
                <div class="cs_fact"><dt class="cs_dt">Status</dt><dd class="os_dd">{t.status}</dd></div>
                {t.proof && <div class="cs_fact"><dt class="cs_dt">{t.proofLabel}</dt><dd class="os_dd">{t.proof}</dd></div>}
              </dl>
              <div class="os_foot">
                {(t.built.length > 0 || t.builtNote) && <div class="os_built">
                  <span class="cs_dt">Built by</span>
                  <ul class="os_people" role="list">
                    {t.built.map((slug) => {
                      const m = people.get(slug);
                      return m && (
                        <li><a class="os_person" href={`/team/${slug}`}>
                          <span class="cs_avatar32">{m.data.portrait && <img alt="" class="cs_avatarimg" src={m.data.portrait} loading="lazy" />}</span>
                          <span>{m.data.name.replace(/ \(.*\)/, '')}</span>
                        </a></li>
                      );
                    })}
                    {t.builtNote && <li class="os_note">{t.builtNote}</li>}
                  </ul>
                </div>}
                <ul aria-label="Links" class="tm_links" role="list">
                  {t.links.map((l) => <li><a class="share_pill" href={l.href}>{l.label}</a></li>)}
                </ul>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="ab_white" data-os="count" id="how-we-count">
      <div class="ab_container">
        <div class="ab_howgrid">
          <div class="ab_howhead">
            <h2 class="ab_h2">How we count</h2>
          </div>
          <div class="os_count">
            <p>A project counts when its public repo uses a tool in code (configuration, dependencies, imports or CLI scripts), or when its contracts use it on chain. Forks count once, and a project using several tools counts once in the total.</p>
            <p>A tool’s own repo never counts toward that tool; our other tools count like any other project. Pages that only mention a tool do not count. Code search does not index every repo, so project counts are floors, and testnet counts include our own testing.</p>
            <p>Every figure carries the date it was counted. Counts that only grow, such as downloads, calls and wallets, are as of that date.</p>
          </div>
        </div>
      </div>
    </section>
    <section>
      <div class="ab_container">
        <div class="ab_howgrid">
          <div class="ab_howhead">
            <h2 class="ab_h2">Standards, libraries and XRPL work</h2>
            <p class="net_carddesc">The smaller pieces: Stellar standards we wrote, code in the official SDK, libraries the CLI depends on, and our work on the XRP Ledger.</p>
          </div>
          <ul class="nx_fundinglist" data-os="standards" role="list">
            {standards.map((s) => (
              <li class="nxjs_fundrow">
                <div><span class="nxjs_fundname">{s.name}</span><span class="nxjs_funddesc">{s.what}</span></div>
                <span class="nxjs_fundbadge">{s.status}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Cta heading="Building on Stellar or XRPL? Talk to the engineers who write the tooling." />
</BaseLayout>
<style>
  .os_grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr)); gap: 24px; margin: 0; padding: 0; list-style: none; }
  .os_card { display: flex; flex-direction: column; gap: 16px; padding: 28px; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-md); scroll-margin-top: 120px; }
  .os_head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .os_name { margin: 0; font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: 30px; line-height: 1.1; color: var(--deep-blue); }
  .os_net { font-size: 12px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--green-ink); }
  .os_what { margin: 0; font-size: 17px; line-height: 1.5; color: var(--ink); }
  .os_why { margin: 0; font-size: 15px; line-height: 1.55; color: var(--ink-2); }
  .os_facts { display: flex; flex-direction: column; gap: 12px; margin: 0; padding-top: 16px; border-top: 1px solid var(--line); }
  .os_dd { margin: 0; font-size: 15px; line-height: 1.45; color: var(--deep-blue); }
  .os_foot { display: flex; flex-direction: column; gap: 16px; margin-top: auto; padding-top: 16px; border-top: 1px solid var(--line); }
  .os_built { display: flex; flex-direction: column; gap: 10px; }
  .os_people { display: flex; flex-wrap: wrap; gap: 8px 16px; margin: 0; padding: 0; list-style: none; }
  .os_person { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 500; color: var(--deep-blue); text-decoration: none; }
  .os_person:hover span:last-child { text-decoration: underline; text-underline-offset: 3px; }
  .os_note { display: inline-flex; align-items: center; font-size: 14px; color: var(--muted); }
  .os_count { display: flex; flex-direction: column; gap: 14px; max-width: 640px; font-size: 16px; line-height: 1.6; color: var(--ink-2); }
  .os_count p { margin: 0; }
</style>
