---
// Generated from the Webflow page "/contact". Edit freely: this file is the source now.
import BaseLayout from '../layouts/BaseLayout.astro';
import { contact } from '../data/site';
---
<BaseLayout title={'Schedule a call with The Aha Company'} description={'Book a call with The Aha Company about regulated assets onchain, a protocol integration on Stellar, XRPL or Canton, or developer tooling for your ecosystem.'}>
<main class="contact_main"><div class="intro"><p class="eyebrow">Contact</p><h1 class="intro_h1">Schedule a call.</h1><p class="text-lead">Thirty minutes with an engineer, not a sales team. Pick a slot, or send a note and we reply within one business day.</p></div><div class="contact-grid"><section aria-label="Booking calendar" class="card calendar"><h2 class="card_h2">Pick a time</h2><div class="calendar_widget"><div class="w-embed"><iframe loading="lazy" src="https://calendly.com/d/cs4b-dy3-9py/introduction-to-the-aha-company?hide_gdpr_banner=1&amp;background_color=fbfaf8&amp;text_color=14243a&amp;primary_color=1a3b60" style="width:100%;height:100%;border:0" title="Schedule a call with The Aha Company"></iframe></div></div><div class="calendar_fallback"><div class="inline-text">Booking not loading? </div><a class="calendar_fallback-link" href="https://calendly.com/d/cs4b-dy3-9py/introduction-to-the-aha-company">Open the calendar in a new tab</a><div class="inline-text"> or email </div><a class="calendar_fallback-link" href="mailto:hello@theaha.co">hello@theaha.co</a><div class="inline-text">.</div></div></section><section aria-label="Contact form" class="card form-card"><h2 class="card_h2">Or send a note</h2><div class="w-form"><form action={contact.formEndpoint || undefined} class="form_form" data-mailto={contact.email} data-name="Email Form" data-subject="Website enquiry: Schedule a call" id="email-form" method="post" name="email-form"><input name="_source" type="hidden" value="theaha.co contact page"/><div class="form_row"><div class="form_label"><label for="name">Name</label><input autocomplete="name" class="form_input w-input" data-name="Name" id="name" maxlength="256" name="name" placeholder="" required="" type="text"/></div><div class="form_label"><label for="email">Work email</label><input autocomplete="email" class="form_input w-input" data-name="Email" id="email" maxlength="256" name="email" placeholder="" required="" type="email"/></div></div><div class="form_row"><div class="form_label"><label for="company">Company</label><input autocomplete="organization" class="form_input w-input" data-name="Field" id="company" maxlength="256" name="company" placeholder="" type="text"/></div><div class="form_label"><label for="role">Role</label><input autocomplete="organization-title" class="form_input w-input" data-name="Field 2" id="role" maxlength="256" name="role" placeholder="" type="text"/></div></div><fieldset class="form_fieldset"><legend class="form_legend">I am</legend><div class="form_radio-group"><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio" name="audience" type="radio" value="institution"/><span class="w-form-label" for="radio">A financial institution</span></label></label><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio-2" name="audience" type="radio" value="protocol"/><span class="w-form-label" for="radio-2">A protocol or product expanding to a new network</span></label></label><label class="form_radio-label"><label class="radio-wrap w-radio"><input class="w-form-formradioinput form_radio-input w-radio-input" data-name="audience" id="radio-3" name="audience" type="radio" value="ecosystem"/><span class="w-form-label" for="radio-3">An ecosystem, foundation or Web3 team</span></label></label></div></fieldset><div class="form_label"><label for="message">Message</label><textarea class="form_textarea w-input" data-name="Field 3" id="message" maxlength="5000" name="message" placeholder="What are you trying to take to mainnet, and on which network?" rows="5"></textarea></div><input class="form_submit w-button" data-wait="Please wait..." type="submit" value="Send message"/></form><div class="form_success w-form-done" role="status"><div class="form_success-inner"><div class="form_success-dot"></div>Sent. We reply within one business day.</div></div><div class="form_error w-form-fail"><div>Oops! Something went wrong while submitting the form.</div></div><div class="form_email-line"><div class="inline-text">Or email </div><a class="form_email-link" href="mailto:hello@theaha.co">hello@theaha.co</a><div class="inline-text"> directly.</div></div></div></section></div></main>
</BaseLayout>
